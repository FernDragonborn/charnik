{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "enables the default permissions",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"allow-pick-data-dir",
		"allow-set-data-dir",
		"allow-saved-data-dir",
		"allow-apply-saved-data-dir",
		"allow-open-app-dir",
		"fs:read-all",
		"fs:write-all",
		"fs:deny-default",
		"dialog:default",
		"opener:default",
		"opener:allow-reveal-item-in-dir",
		"updater:default",
		"process:default",
		"log:default",
		{
			"identifier": "http:default",
			"allow": [
				{ "url": "https://api.github.com/repos/*" },
				{ "url": "https://raw.githubusercontent.com/*" }
			],
			"deny": [{ "url": "http://**" }]
		},
		{
			"identifier": "fs:scope",
			"allow": [{ "path": "$DOCUMENT/charnik" }, { "path": "$DOCUMENT/charnik/**" }],
			"deny": [
				{ "path": "$APPCONFIG" },
				{ "path": "$APPCONFIG/**" },
				{ "path": "$APPDATA" },
				{ "path": "$APPDATA/**" },
				{ "path": "$APPLOCALDATA" },
				{ "path": "$APPLOCALDATA/**" }
			]
		}
	]
}
