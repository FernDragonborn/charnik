{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "enables the default permissions",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"allow-pick-data-dir",
		"allow-set-data-dir",
		"allow-saved-data-dir",
		"allow-apply-saved-data-dir",
		"allow-open-app-dir",
		"allow-proposed-data-dir",
		"allow-fetch-pack-text",
		"allow-fetch-pack-bytes",
		"allow-plugin-prefs",
		"allow-grant-plugin-consent",
		"allow-forget-plugins",
		"allow-set-plugin-enabled",
		"allow-set-plugin-kill-switch",
		"fs:read-all",
		"fs:write-all",
		"fs:deny-default",
		"dialog:default",
		"opener:default",
		"opener:allow-reveal-item-in-dir",
		"allow-check-app-update",
		"allow-install-app-update",
		"log:default",
		{
			"identifier": "fs:scope",
			"allow": [{ "path": "$DOCUMENT/charnik" }, { "path": "$DOCUMENT/charnik/**" }],
			"deny": [
				{ "path": "$APPCONFIG" },
				{ "path": "$APPCONFIG/**" },
				{ "path": "$APPDATA" },
				{ "path": "$APPDATA/**" },
				{ "path": "$APPLOCALDATA" },
				{ "path": "$APPLOCALDATA/**" }
			]
		}
	]
}
