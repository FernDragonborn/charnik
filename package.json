{
	"name": "charnik",
	"private": true,
	"version": "0.7.0",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.3.0",
	"scripts": {
		"content:static": "node tools/build-static-content.mjs",
		"restamp": "tsx tools/restamp.ts",
		"surface": "node tools/surface.mjs",
		"predev": "node tools/build-static-content.mjs",
		"dev": "vite dev",
		"prebuild": "node tools/build-static-content.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint . && stylelint --config config/stylelint.json \"src/**/*.{css,svelte}\" && knip --config config/knip.json && jscpd -c config/jscpd.json && madge --circular src",
		"lint:typed": "eslint -c config/eslint.typed.config.js .",
		"lint:typed:changed": "node tools/lint-typed-changed.mjs",
		"lint:fix": "prettier --write . && eslint . --fix && stylelint --config config/stylelint.json \"src/**/*.{css,svelte}\" --fix",
		"knip": "knip --config config/knip.json",
		"jscpd": "jscpd -c config/jscpd.json --reporters consoleFull",
		"loc": "node tools/loc.mjs",
		"postinstall": "simple-git-hooks",
		"plugin:test": "tsx tools/plugin-test.ts"
	},
	"simple-git-hooks": {
		"pre-commit": "node tools/surface.mjs && git add docs/surface.md && npx prettier --check . && npx eslint . && npx jscpd -c config/jscpd.json",
		"pre-push": "pnpm check && pnpm lint && pnpm test"
	},
	"prettier": {
		"useTabs": true,
		"singleQuote": true,
		"trailingComma": "all",
		"printWidth": 100,
		"plugins": [
			"prettier-plugin-svelte"
		],
		"overrides": [
			{
				"files": "*.svelte",
				"options": {
					"parser": "svelte"
				}
			}
		]
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tauri-apps/cli": "^2.11.4",
		"@types/papaparse": "^5.5.2",
		"@vitest/browser": "^4.1.11",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fake-indexeddb": "^6.2.5",
		"fast-check": "^4.9.0",
		"globals": "^17.12.0",
		"jscpd": "^5.2.0",
		"knip": "^6.35.1",
		"madge": "^8.0.0",
		"pixelmatch": "^7.2.0",
		"playwright": "^1.63.0",
		"pngjs": "^7.0.0",
		"postcss-html": "^1.8.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"simple-git-hooks": "^2.14.0",
		"stylelint": "^17.15.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@jitl/quickjs-ng-wasmfile-release-sync": "^0.32.0",
		"@lucide/svelte": "^1.44.0",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-fs": "~2.5.2",
		"@tauri-apps/plugin-http": "^2.6.0",
		"@tauri-apps/plugin-log": "^2.9.1",
		"@tauri-apps/plugin-opener": "^2.5.5",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.11.0",
		"dompurify": "^3.4.15",
		"fastest-levenshtein": "^1.0.16",
		"fuse.js": "^7.5.0",
		"idb": "^8.0.3",
		"marked": "^18.0.12",
		"papaparse": "^5.7.0",
		"quickjs-emscripten-core": "^0.32.0",
		"svelte-dnd-action": "^0.9.79",
		"svelte-i18n": "^4.0.1",
		"svelte-sonner": "^1.2.1",
		"xxhash-wasm": "^1.1.0",
		"zod": "^4.6.2"
	}
}
