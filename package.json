{
	"name": "charnik",
	"private": true,
	"version": "0.8.2",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.3.0",
	"scripts": {
		"content:static": "node tools/build-static-content.mjs",
		"restamp": "tsx tools/restamp.ts",
		"import-translations": "tsx tools/import-translations.ts",
		"surface": "node tools/surface.mjs",
		"predev": "node tools/build-static-content.mjs",
		"dev": "vite dev",
		"prebuild": "node tools/build-static-content.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint . && stylelint --config config/stylelint.json \"src/**/*.{css,svelte}\" && knip --config config/knip.json && jscpd -c config/jscpd.json && madge --circular src",
		"lint:typed": "eslint -c config/eslint.typed.config.js .",
		"lint:typed:changed": "node tools/lint-typed-changed.mjs",
		"lint:fix": "prettier --write . && eslint . --fix && stylelint --config config/stylelint.json \"src/**/*.{css,svelte}\" --fix",
		"knip": "knip --config config/knip.json",
		"jscpd": "jscpd -c config/jscpd.json --reporters consoleFull",
		"loc": "node tools/loc.mjs",
		"postinstall": "simple-git-hooks",
		"plugin:test": "tsx tools/plugin-test.ts"
	},
	"simple-git-hooks": {
		"pre-commit": "node tools/surface.mjs && git add docs/surface.md && npx prettier --check . && npx eslint . && npx jscpd -c config/jscpd.json",
		"pre-push": "pnpm check && pnpm lint && pnpm test --reporter=default --reporter=json --outputFile.json=.git/last-pre-push-tests.json"
	},
	"prettier": {
		"useTabs": true,
		"singleQuote": true,
		"trailingComma": "all",
		"printWidth": 100,
		"plugins": [
			"prettier-plugin-svelte"
		],
		"overrides": [
			{
				"files": "*.svelte",
				"options": {
					"parser": "svelte"
				}
			}
		]
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tauri-apps/cli": "^2.12.3",
		"@types/papaparse": "^5.5.2",
		"@vitest/browser": "^4.1.12",
		"@vitest/browser-playwright": "^4.1.12",
		"@vitest/coverage-v8": "^4.1.12",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"fake-indexeddb": "^6.2.6",
		"fast-check": "^4.10.2",
		"globals": "^17.13.0",
		"jscpd": "^5.4.1",
		"knip": "^6.42.1",
		"madge": "^8.0.0",
		"pixelmatch": "^7.2.0",
		"playwright": "^1.64.1",
		"pngjs": "^7.0.0",
		"postcss-html": "^2.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"simple-git-hooks": "^2.14.0",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.4",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@jitl/quickjs-ng-wasmfile-release-sync": "^0.32.0",
		"@lucide/svelte": "^1.59.0",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-fs": "~2.7.1",
		"@tauri-apps/plugin-log": "^2.10.1",
		"@tauri-apps/plugin-opener": "^2.7.2",
		"dompurify": "^3.4.17",
		"fastest-levenshtein": "^1.0.16",
		"fuse.js": "^7.5.0",
		"idb": "^8.0.4",
		"marked": "^18.1.1",
		"papaparse": "^5.7.0",
		"quickjs-emscripten-core": "^0.32.0",
		"svelte-dnd-action": "^0.9.80",
		"svelte-i18n": "^4.0.1",
		"svelte-sonner": "^1.2.1",
		"xxhash-wasm": "^1.1.0",
		"zod": "^4.6.7"
	}
}
