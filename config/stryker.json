{
	"$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-core.json",
	"packageManager": "pnpm",
	"inPlace": true,
	"testRunner": "vitest",
	"plugins": ["@stryker-mutator/vitest-runner"],
	"vitest": {
		"configFile": "config/vitest.mutation.config.ts"
	},
	"mutate": ["src/lib/rules/**/*.ts", "!src/lib/rules/**/*.test.ts"],
	"coverageAnalysis": "perTest",
	"concurrency": 4,
	"timeoutMS": 20000,
	"reporters": ["progress", "clear-text", "json", "html"],
	"htmlReporter": {
		"fileName": "reports/mutation/rules.html"
	},
	"jsonReporter": {
		"fileName": "reports/mutation/rules.json"
	},
	"thresholds": {
		"high": 80,
		"low": 60,
		"break": null
	}
}
